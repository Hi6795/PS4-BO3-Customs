<UserControl x:Class="FFPorter.Desktop.Controls.ConsolePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>

    <Style x:Key="NoteText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="failed"><Setter Property="Foreground" Value="{DynamicResource Status.Error}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="cancelled"><Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/></DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ItemRow">
      <Border BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="10,0" MinHeight="52" Background="Transparent" ToolTip="{Binding Tip}">
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="48"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource KindTag}" Tag="{Binding Tag}">
            <TextBlock Text="{Binding Tag}" Tag="{Binding Tag}" Style="{StaticResource KindText}"/>
          </Border>
          <DockPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Tag="{Binding NoteState}" Style="{StaticResource NoteText}" Margin="12,0,0,0" MaxWidth="250" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Note}" Visibility="{Binding HasNote, Converter={StaticResource Visible}}"/>
            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <TextBlock Grid.Column="2" Text="{Binding Folder}" Style="{StaticResource Text.Caption}" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="{Binding CountText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Typography.NumeralAlignment="Tabular"/>
          <TextBlock Grid.Column="4" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
          <Button Grid.Column="5" Style="{StaticResource Button.Icon}" Content="&#xE74D;" Click="RemoveClick" ToolTip="Remove from the console" HorizontalAlignment="Right"
                  IsEnabled="{Binding CanRemove}"/>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Border Style="{StaticResource Card}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Margin="20,18,16,14">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Grid Width="280" Margin="0,0,8,0">
            <TextBox x:Name="SearchBox" Padding="38,8,12,8" TextChanged="SearchChanged" ToolTip="Search by name or path"/>
            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" FontSize="14" Foreground="{DynamicResource Text.Muted}" Margin="14,0,0,0" HorizontalAlignment="Left"
                       IsHitTestVisible="False"/>
            <TextBlock x:Name="SearchHint" Text="Search" FontSize="14" Foreground="{DynamicResource Text.Muted}" Margin="41,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
          <Button x:Name="RefreshButton" Style="{StaticResource Button.Icon}" Content="&#xE72C;" Click="RefreshClick" ToolTip="Read the console again"/>
        </StackPanel>
        <Border Style="{StaticResource Segment}">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="AllFilter" Style="{StaticResource Tab.Segment}" GroupName="ConsoleKind" IsChecked="True" Tag="" ToolTip="Everything on the console">
            <TextBlock><Run Text="All"/><Run x:Name="AllCount" FontWeight="Normal" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
          </RadioButton>
          <RadioButton x:Name="ZombiesFilter" Style="{StaticResource Tab.Segment}" GroupName="ConsoleKind" Tag="zombies" Margin="2,0,0,0" ToolTip="Zombies maps">
            <TextBlock><Run Text="Zombies"/><Run x:Name="ZombiesCount" FontWeight="Normal" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
          </RadioButton>
          <RadioButton x:Name="MultiplayerFilter" Style="{StaticResource Tab.Segment}" GroupName="ConsoleKind" Tag="multiplayer" Margin="2,0,0,0" ToolTip="Multiplayer maps">
            <TextBlock><Run Text="Multiplayer"/><Run x:Name="MultiplayerCount" FontWeight="Normal" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
          </RadioButton>
          <RadioButton x:Name="ModsFilter" Style="{StaticResource Tab.Segment}" GroupName="ConsoleKind" Tag="mod" Margin="2,0,0,0" ToolTip="Mods">
            <TextBlock><Run Text="Mods"/><Run x:Name="ModsCount" FontWeight="Normal" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
          </RadioButton>
        </StackPanel>
        </Border>
      </DockPanel>

      <ScrollViewer x:Name="ListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Visibility="Collapsed">
        <ItemsControl x:Name="ItemList" ItemTemplate="{StaticResource ItemRow}" Margin="14,0,14,10" Focusable="False">
          <ItemsControl.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <DockPanel Margin="10,20,10,8">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Name.Summary}" Style="{StaticResource Text.Caption}" Margin="16,0,0,0" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Name.Title, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding Name.Root, Mode=OneWay}" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"/>
                    </TextBlock>
                  </DockPanel>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ItemsControl.GroupStyle>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
        <Border Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource IconTile.Glyph}" Text="&#xE7FC;"/></Border>
        <TextBlock x:Name="EmptyTitle" Style="{StaticResource Text.Title}" FontSize="19" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,18,0,0"/>
        <TextBlock x:Name="EmptyText" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
