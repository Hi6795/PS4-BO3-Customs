<Window x:Class="FFPorter.Desktop.InstalledWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installed maps and mods" Width="700" Height="680" MinWidth="520" MinHeight="420" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Surface}" Foreground="{DynamicResource Text.Primary}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </Window.Resources>
  <Grid LayoutTransform="{DynamicResource Ui.Scale}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="24,22,24,14">
      <Grid>
        <TextBox x:Name="SearchBox" Padding="38,8,12,8" TextChanged="SearchChanged"/>
        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" FontSize="14" Foreground="{DynamicResource Text.Muted}" Margin="14,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
        <TextBlock x:Name="SearchHint" Text="Search" FontSize="14" Foreground="{DynamicResource Text.Muted}" Margin="41,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <Border Style="{StaticResource Segment}" Margin="0,14,0,0">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="AllFilter" Style="{StaticResource Tab.Segment}" GroupName="InstalledKind" IsChecked="True" Tag="" ToolTip="Everything that was found">
            <TextBlock><Run Text="All"/><Run x:Name="AllCount" FontWeight="Normal" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
          </RadioButton>
          <RadioButton x:Name="ZombiesFilter" Style="{StaticResource Tab.Segment}" GroupName="InstalledKind" Tag="zombies" Margin="2,0,0,0" ToolTip="Zombies maps">
            <TextBlock><Run Text="Zombies"/><Run x:Name="ZombiesCount" FontWeight="Normal" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
          </RadioButton>
          <RadioButton x:Name="MultiplayerFilter" Style="{StaticResource Tab.Segment}" GroupName="InstalledKind" Tag="multiplayer" Margin="2,0,0,0" ToolTip="Multiplayer maps">
            <TextBlock><Run Text="Multiplayer"/><Run x:Name="MultiplayerCount" FontWeight="Normal" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
          </RadioButton>
          <RadioButton x:Name="ModsFilter" Style="{StaticResource Tab.Segment}" GroupName="InstalledKind" Tag="mod" Margin="2,0,0,0" ToolTip="Mods">
            <TextBlock><Run Text="Mods"/><Run x:Name="ModsCount" FontWeight="Normal" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
          </RadioButton>
        </StackPanel>
      </Border>
    </StackPanel>
    <ListBox x:Name="Items" Grid.Row="1" Margin="14,0,14,10" SelectionMode="Extended" ItemContainerStyle="{StaticResource ListItem.Row}" SelectionChanged="SelectionChanged"
             MouseDoubleClick="ItemDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="100" Height="56">
              <Border CornerRadius="8" Background="{DynamicResource Bg.Raised}">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8B9;" FontSize="18" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center"/>
              </Border>
              <Border CornerRadius="8" Visibility="{Binding HasPicture, Converter={StaticResource Visible}}">
                <Border.Background><ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill"/></Border.Background>
              </Border>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,6,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" Visibility="Collapsed">
      <Border Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource IconTile.Glyph}" Text="&#xE8B7;"/></Border>
      <TextBlock x:Name="EmptyTitle" Style="{StaticResource Text.Title}" FontSize="19" HorizontalAlignment="Center" Margin="0,18,0,0"/>
      <TextBlock x:Name="EmptyText" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
    </StackPanel>
    <Border Grid.Row="2" Background="{DynamicResource Bg.App}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="26,16">
      <DockPanel>
        <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Add" IsDefault="True" IsEnabled="False" MinWidth="120" Margin="10,0,0,0" Click="AddClick"/>
        <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="110" MinHeight="40"/>
        <TextBlock x:Name="CountText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
