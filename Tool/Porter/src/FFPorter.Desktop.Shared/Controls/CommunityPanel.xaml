<UserControl x:Class="FFPorter.Desktop.Controls.CommunityPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>

    <Style x:Key="NoteText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="failed"><Setter Property="Foreground" Value="{DynamicResource Status.Error}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="cancelled"><Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="done"><Setter Property="Foreground" Value="{DynamicResource Status.Success}"/></DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="MapRow">
      <Border BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="10,16" Background="Transparent" ToolTip="{Binding Tip}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="160" Height="90" Margin="0,0,20,0" VerticalAlignment="Center">
            <Border CornerRadius="10" Background="{DynamicResource Bg.Raised}">
              <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8B9;" FontSize="24" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center"/>
            </Border>
            <Border CornerRadius="10" Visibility="{Binding HasPicture, Converter={StaticResource Visible}}">
              <Border.Background><ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill"/></Border.Background>
            </Border>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="16"/>
              <Run Text="{Binding VersionText, Mode=OneWay}" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"/>
            </TextBlock>
            <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" FontSize="13.5" Margin="0,7,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasDescription, Converter={StaticResource Visible}}"/>
            <Grid Margin="0,11,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ProgressBar Height="6" Maximum="1" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding StageText}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                         Typography.NumeralAlignment="Tabular"/>
            </Grid>
            <TextBlock Text="{Binding Note}" Tag="{Binding NoteState}" Style="{StaticResource NoteText}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"
                       Visibility="{Binding HasNote, Converter={StaticResource Visible}}"/>
          </StackPanel>
          <Grid Grid.Column="2" VerticalAlignment="Center" Margin="20,0,2,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Button Content="{Binding ActionText}" Style="{StaticResource Button.Primary}" MinWidth="132" Click="StartClick"
                    Visibility="{Binding CanStart, Converter={StaticResource Visible}}"/>
            <Button Style="{StaticResource Button.Icon}" Content="{Binding PauseGlyph}" Click="PauseClick" HorizontalAlignment="Right"
                    ToolTip="Pause or resume. While sending to the console, the file being sent is finished first."
                    Visibility="{Binding CanPause, Converter={StaticResource Visible}}"/>
            <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Content="&#xE711;" Click="CancelClick" ToolTip="Cancel" HorizontalAlignment="Right"
                    Visibility="{Binding CanCancel, Converter={StaticResource Visible}}"/>
            <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Content="&#xE712;" Click="MoreClick" ToolTip="More" HorizontalAlignment="Right"
                    Visibility="{Binding HasMenu, Converter={StaticResource Visible}}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open its folder" Click="OpenClick" Visibility="{Binding CanOpen, Converter={StaticResource Visible}}"/>
                  <MenuItem Header="Send to the console again" Click="ResendClick" Visibility="{Binding CanResend, Converter={StaticResource Visible}}"/>
                  <MenuItem Header="Delete from this PC" Click="DeleteClick" Visibility="{Binding CanDelete, Converter={StaticResource Visible}}"/>
                  <MenuItem Header="Remove from the console" Click="RemoveClick" Visibility="{Binding CanRemove, Converter={StaticResource Visible}}"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Border Style="{StaticResource Card}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Margin="20,18,16,14">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Grid Width="280" Margin="0,0,8,0">
            <TextBox x:Name="SearchBox" Padding="38,8,12,8" TextChanged="SearchChanged" ToolTip="Search by title, zone name or author"/>
            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" FontSize="14" Foreground="{DynamicResource Text.Muted}" Margin="14,0,0,0" HorizontalAlignment="Left"
                       IsHitTestVisible="False"/>
            <TextBlock x:Name="SearchHint" Text="Search" FontSize="14" Foreground="{DynamicResource Text.Muted}" Margin="41,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
          <Button x:Name="RefreshButton" Style="{StaticResource Button.Icon}" Content="&#xE72C;" Click="RefreshClick" ToolTip="Load the list again"/>
        </StackPanel>
        <Border Style="{StaticResource Segment}">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="AllFilter" Style="{StaticResource Tab.Segment}" GroupName="CommunityKind" IsChecked="True" Tag="" ToolTip="Everything in the list">
            <TextBlock><Run Text="All"/><Run x:Name="AllCount" FontWeight="Normal" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
          </RadioButton>
          <RadioButton x:Name="ZombiesFilter" Style="{StaticResource Tab.Segment}" GroupName="CommunityKind" Tag="zombies" Margin="2,0,0,0" ToolTip="Zombies maps">
            <TextBlock><Run Text="Zombies"/><Run x:Name="ZombiesCount" FontWeight="Normal" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
          </RadioButton>
          <RadioButton x:Name="MultiplayerFilter" Style="{StaticResource Tab.Segment}" GroupName="CommunityKind" Tag="multiplayer" Margin="2,0,0,0" ToolTip="Multiplayer maps">
            <TextBlock><Run Text="Multiplayer"/><Run x:Name="MultiplayerCount" FontWeight="Normal" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
          </RadioButton>
          <RadioButton x:Name="ModsFilter" Style="{StaticResource Tab.Segment}" GroupName="CommunityKind" Tag="mod" Margin="2,0,0,0" ToolTip="Mods">
            <TextBlock><Run Text="Mods"/><Run x:Name="ModsCount" FontWeight="Normal" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
          </RadioButton>
        </StackPanel>
        </Border>
      </DockPanel>

      <ScrollViewer x:Name="ListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ItemsControl x:Name="MapList" ItemTemplate="{StaticResource MapRow}" Margin="14,0,14,10" Focusable="False"/>
      </ScrollViewer>

      <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" Visibility="Collapsed">
        <Border Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource IconTile.Glyph}" Text="&#xE774;"/></Border>
        <TextBlock x:Name="EmptyTitle" Style="{StaticResource Text.Title}" FontSize="19" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,18,0,0"/>
        <TextBlock x:Name="EmptyText" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
