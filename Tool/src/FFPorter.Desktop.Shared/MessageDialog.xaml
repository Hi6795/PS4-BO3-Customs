<Window x:Class="FFPorter.Desktop.MessageDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Surface}" Foreground="{DynamicResource Text.Primary}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FocusManager.FocusedElement="{Binding ElementName=ConfirmButton}">
  <Grid LayoutTransform="{DynamicResource Ui.Scale}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="28,26,30,28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource Grade.None.Soft}" VerticalAlignment="Top" Margin="0,0,18,0">
        <TextBlock x:Name="IconText" Style="{StaticResource Text.Icon}" FontSize="22" HorizontalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Heading}" FontSize="17" TextWrapping="Wrap"/>
        <ScrollViewer x:Name="BodyScroll" MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
          <TextBlock x:Name="BodyText" Style="{StaticResource Text.Body}"/>
        </ScrollViewer>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource Bg.App}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="26,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" IsCancel="True" MinWidth="110" MinHeight="40"/>
        <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}" IsDefault="True" MinWidth="110" Margin="10,0,0,0" Click="ConfirmClick"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
