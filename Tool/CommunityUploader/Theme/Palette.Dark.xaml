<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.App">#0A0B0D</Color>
  <Color x:Key="Color.Caption">#0A0B0D</Color>
  <Color x:Key="Color.CaptionText">#7C828E</Color>

  <SolidColorBrush x:Key="Bg.App" Color="#0A0B0D"/>
  <SolidColorBrush x:Key="Bg.Rail" Color="#0A0B0D"/>
  <SolidColorBrush x:Key="Bg.Sheet" Color="#101216"/>
  <SolidColorBrush x:Key="Bg.Surface" Color="#16181D"/>
  <SolidColorBrush x:Key="Bg.Raised" Color="#1D2026"/>
  <SolidColorBrush x:Key="Bg.Input" Color="#0D0E12"/>
  <SolidColorBrush x:Key="Bg.Hover" Color="#22252C"/>
  <SolidColorBrush x:Key="Bg.Pressed" Color="#2A2E36"/>
  <SolidColorBrush x:Key="Bg.Selected" Color="#252930"/>
  <SolidColorBrush x:Key="Bg.Track" Color="#262A31"/>
  <SolidColorBrush x:Key="Bg.Overlay" Color="#E60A0B0D"/>

  <SolidColorBrush x:Key="Border.Subtle" Color="#1F2228"/>
  <SolidColorBrush x:Key="Border.Default" Color="#2B2F37"/>
  <SolidColorBrush x:Key="Border.Strong" Color="#474C57"/>

  <SolidColorBrush x:Key="Text.Primary" Color="#F4F5F7"/>
  <SolidColorBrush x:Key="Text.Secondary" Color="#ADB2BC"/>
  <SolidColorBrush x:Key="Text.Muted" Color="#727885"/>
  <SolidColorBrush x:Key="Text.Selection" Color="#80FF6A00"/>

  <SolidColorBrush x:Key="Accent" Color="#FF6A00"/>
  <SolidColorBrush x:Key="Accent.Hover" Color="#FF8329"/>
  <SolidColorBrush x:Key="Accent.Pressed" Color="#E05C00"/>
  <SolidColorBrush x:Key="Accent.Text" Color="#170A00"/>
  <SolidColorBrush x:Key="Accent.Soft" Color="#24FF6A00"/>
  <SolidColorBrush x:Key="Accent.Line" Color="#59FF6A00"/>
  <LinearGradientBrush x:Key="Progress.Fill" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FF6A00" Offset="0"/>
    <GradientStop Color="#FFA23A" Offset="1"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="Accent.Glow" Center="0.2,0" GradientOrigin="0.2,0" RadiusX="0.9" RadiusY="1">
    <GradientStop Color="#30FF6A00" Offset="0"/>
    <GradientStop Color="#00FF6A00" Offset="1"/>
  </RadialGradientBrush>

  <SolidColorBrush x:Key="Grade.Exact" Color="#4ADE80"/>
  <SolidColorBrush x:Key="Grade.Strong" Color="#A3E635"/>
  <SolidColorBrush x:Key="Grade.Good" Color="#FACC15"/>
  <SolidColorBrush x:Key="Grade.Approximate" Color="#FB923C"/>
  <SolidColorBrush x:Key="Grade.Weak" Color="#F87171"/>
  <SolidColorBrush x:Key="Grade.Exact.Soft" Color="#1F4ADE80"/>
  <SolidColorBrush x:Key="Grade.Strong.Soft" Color="#1FA3E635"/>
  <SolidColorBrush x:Key="Grade.Good.Soft" Color="#1FFACC15"/>
  <SolidColorBrush x:Key="Grade.Approximate.Soft" Color="#1FFB923C"/>
  <SolidColorBrush x:Key="Grade.Weak.Soft" Color="#1FF87171"/>
  <SolidColorBrush x:Key="Grade.None.Soft" Color="#14FFFFFF"/>

  <SolidColorBrush x:Key="Status.Success" Color="#4ADE80"/>
  <SolidColorBrush x:Key="Status.Success.Soft" Color="#1F4ADE80"/>
  <SolidColorBrush x:Key="Status.Error" Color="#F87171"/>
  <SolidColorBrush x:Key="Status.Error.Soft" Color="#1FF87171"/>
  <SolidColorBrush x:Key="Status.Warning" Color="#FBBF24"/>
  <SolidColorBrush x:Key="Status.Warning.Soft" Color="#1FFBBF24"/>
  <SolidColorBrush x:Key="Status.Running" Color="#FF6A00"/>

  <SolidColorBrush x:Key="Danger" Color="#F87171"/>
  <SolidColorBrush x:Key="Danger.Hover" Color="#FCA5A5"/>
  <SolidColorBrush x:Key="Danger.Pressed" Color="#EF4444"/>
  <SolidColorBrush x:Key="Danger.Text" Color="#1A0505"/>

  <ScaleTransform x:Key="Ui.Scale" ScaleX="1" ScaleY="1"/>
</ResourceDictionary>
