<Window x:Class="FFPorter.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="1020" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Sheet}" Foreground="{DynamicResource Text.Primary}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FocusManager.FocusedElement="{Binding ElementName=DoneButton}">
  <Grid LayoutTransform="{DynamicResource Ui.Scale}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="26,24,26,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="9*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="11*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="22,20,22,22" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="SPEED" Style="{StaticResource Text.Section}"/>
          <CheckBox x:Name="AsyncSwitch" Style="{StaticResource Switch.Setting}" Content="Parallel" Margin="0,14,0,0" Checked="AsyncToggled" Unchecked="AsyncToggled"/>
          <CheckBox x:Name="MultiConversionSwitch" Style="{StaticResource Switch.Setting}" Content="Multi-conversion" Margin="0,18,0,0"
                    Checked="MultiConversionToggled" Unchecked="MultiConversionToggled"/>
          <CheckBox x:Name="MultiCoreSwitch" Style="{StaticResource Switch.Setting}" Content="Multi-core" Margin="0,18,0,0"
                    Checked="MultiCoreToggled" Unchecked="MultiCoreToggled"/>
          <CheckBox x:Name="GpuVideoSwitch" Style="{StaticResource Switch.Setting}" Content="GPU video" Margin="0,18,0,0"
                    Checked="GpuVideoToggled" Unchecked="GpuVideoToggled"/>
          <Border Style="{StaticResource Rule}" Margin="0,22,0,20"/>
          <TextBlock Text="CLEAN-UP" Style="{StaticResource Text.Section}"/>
          <CheckBox x:Name="DeleteOriginalsSwitch" Style="{StaticResource Switch.Setting}" Content="Delete PC originals" Margin="0,14,0,0"
                    Checked="DeleteOriginalsToggled" Unchecked="DeleteOriginalsToggled"/>
          <CheckBox x:Name="DeleteCacheSwitch" Style="{StaticResource Switch.Setting}" Content="Delete the cache" Margin="0,18,0,0"
                    Checked="DeleteCacheToggled" Unchecked="DeleteCacheToggled"/>
          <Border Style="{StaticResource Rule}" Margin="0,22,0,20"/>
          <TextBlock Text="LOOK" Style="{StaticResource Text.Section}"/>
          <DockPanel Margin="0,14,0,0">
            <ComboBox x:Name="ScaleBox" DockPanel.Dock="Right" Width="120" Margin="16,0,0,0" VerticalAlignment="Center" SelectionChanged="ScaleChanged"
                      ToolTip="Auto fits everything to the screen the window is on. Pick a size to keep it fixed."/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Interface size" FontSize="14.5" FontWeight="SemiBold"/>
              <TextBlock x:Name="ScaleText" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,20,22,22" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="CONSOLE" Style="{StaticResource Text.Section}"/>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ConsoleBox" TextChanged="ConsoleChanged"/>
            <TextBlock x:Name="ConsoleHint" Text="Console IP, like 192.168.1.50" FontSize="14" Foreground="{DynamicResource Text.Muted}" Margin="15,0,11,0" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
            <Button x:Name="ConsoleTest" Grid.Column="1" Content="Test" MinWidth="84" Margin="8,0,0,0" Click="ConsoleTestClick"
                    ToolTip="Connects to the console and writes a small test file to each drive, deleting it again, to see which ones can be used"/>
          </Grid>
          <TextBlock x:Name="ConsoleResult" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" Visibility="Collapsed"/>
          <DockPanel Margin="0,18,0,0">
            <ComboBox x:Name="StorageBox" DockPanel.Dock="Right" Width="170" Margin="16,0,0,0" VerticalAlignment="Center" SelectionChanged="StorageChanged"
                      ToolTipService.ShowOnDisabled="True"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Send to" FontSize="14.5" FontWeight="SemiBold"/>
              <TextBlock x:Name="StorageText" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
          <CheckBox x:Name="SendSwitch" Style="{StaticResource Switch.Setting}" Content="Auto-FTP" Margin="0,18,0,0"
                    Checked="SendToggled" Unchecked="SendToggled"/>
          <Grid x:Name="FilesRow" Margin="0,18,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="FilesAbout" VerticalAlignment="Center" Background="Transparent">
              <TextBlock TextTrimming="CharacterEllipsis" FontSize="14.5">
                <Run Text="Console files" FontWeight="SemiBold"/><Run x:Name="FilesVersion" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"/>
              </TextBlock>
              <TextBlock x:Name="FilesText" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                         Typography.NumeralAlignment="Tabular"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
              <Button x:Name="FilesStart" MinWidth="104" Click="FilesStartClick" Visibility="Collapsed"/>
              <Button x:Name="FilesPause" Style="{StaticResource Button.Icon}" Click="FilesPauseClick" Visibility="Collapsed"/>
              <Button x:Name="FilesCancel" Style="{StaticResource Button.Icon}" Content="&#xE711;" Margin="4,0,0,0" Click="FilesCancelClick" ToolTip="Cancel" Visibility="Collapsed"/>
              <Button x:Name="FilesMore" Style="{StaticResource Button.Icon}" Content="&#xE712;" Margin="4,0,0,0" Click="FilesMoreClick" ToolTip="More" Visibility="Collapsed">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem x:Name="FilesOpenItem" Header="Open its folder" Click="FilesOpenClick"/>
                    <MenuItem x:Name="FilesResendItem" Header="Send to the console again" Click="FilesResendClick"/>
                    <MenuItem x:Name="FilesDeleteItem" Header="Delete from this PC" Click="FilesDeleteClick"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
            <ProgressBar x:Name="FilesProgress" Grid.ColumnSpan="2" Height="4" Maximum="1" VerticalAlignment="Bottom" Margin="0,0,0,-12" Visibility="Collapsed"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource Bg.App}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="26,16">
      <DockPanel>
        <Button x:Name="DoneButton" DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Done" IsDefault="True" IsCancel="True" MinWidth="120"/>
        <Button x:Name="CheckButton" DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Check for updates" Margin="0,0,10,0" Click="CheckClick" Visibility="Collapsed"/>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="StateText" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
          <TextBlock x:Name="BuildText" Style="{StaticResource Text.Caption}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
