<Window x:Class="FFPorter.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FFPorter.Desktop.Controls" xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="PC → PS4 FF Converter" Width="1380" Height="880" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.App}" Foreground="{DynamicResource Text.Primary}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>

    <DataTemplate x:Key="StateIcon">
      <Grid Width="20" Height="20">
        <Ellipse x:Name="Ring" Width="11" Height="11" Stroke="{DynamicResource Border.Strong}" StrokeThickness="1.6" Visibility="Collapsed"/>
        <Ellipse x:Name="Dot" Style="{StaticResource StatusDot}" Tag="{Binding}" HorizontalAlignment="Center" Visibility="Collapsed"/>
        <TextBlock x:Name="Glyph" Style="{StaticResource Text.Icon}" FontSize="14" HorizontalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding}" Value="ready">
          <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="queued">
          <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Glyph" Property="Text" Value="&#xE823;"/>
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="running">
          <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="done">
          <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;"/>
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Status.Success}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="failed">
          <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Glyph" Property="Text" Value="&#xE711;"/>
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Status.Error}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="cancelled">
          <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Glyph" Property="Text" Value="&#xE71A;"/>
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="skipped">
          <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Glyph" Property="Text" Value="&#xE738;"/>
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="paused">
          <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Glyph" Property="Text" Value="&#xE769;"/>
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="NoteText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="failed"><Setter Property="Foreground" Value="{DynamicResource Status.Error}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="cancelled"><Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/></DataTrigger>
      </Style.Triggers>
    </Style>

    <x:Array x:Key="Grades" Type="sys:String">
      <sys:String>exact</sys:String>
      <sys:String>strong</sys:String>
      <sys:String>good</sys:String>
      <sys:String>approximate</sys:String>
      <sys:String>weak</sys:String>
    </x:Array>

    <DataTemplate x:Key="LegendItem">
      <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
        <Border Style="{StaticResource GradeFill}" Tag="{Binding}" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Margin="7,0,0,1"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="StepChip">
      <Border Margin="0,8,8,0" Padding="10,5,12,6" CornerRadius="9" Background="{DynamicResource Bg.Input}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
              ToolTip="{Binding Detail}" ToolTipService.IsEnabled="{Binding HasDetail}">
        <StackPanel Orientation="Horizontal">
          <ContentControl Content="{Binding IconState}" ContentTemplate="{StaticResource StateIcon}" Margin="0,0,7,0" Focusable="False" VerticalAlignment="Center"/>
          <TextBlock x:Name="StepTitle" Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
          <TextBlock x:Name="StepPercent" Text="{Binding PercentText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="9,0,0,0" VerticalAlignment="Center"
                     Typography.NumeralAlignment="Tabular" Visibility="Collapsed"/>
          <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Text.Caption}" Margin="9,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="waiting"><Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource Text.Muted}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="skipped"><Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource Text.Muted}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="running">
          <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource Text.Primary}"/>
          <Setter TargetName="StepTitle" Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="StepPercent" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="failed"><Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource Status.Error}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="cancelled"><Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource Status.Warning}"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ActiveStep">
      <Border Width="240" Margin="0,0,10,0" Padding="12,8,12,10" CornerRadius="10" Background="{DynamicResource Bg.Input}" ToolTip="{Binding Detail}" ToolTipService.IsEnabled="{Binding HasDetail}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" Typography.NumeralAlignment="Tabular"/>
          <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,7,0,0"/>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="DimensionRow">
      <Border BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="0,11,0,11">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsAbsent}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="112"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Top" ToolTip="{Binding Description}" Background="Transparent">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasUnits}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Ellipse Width="7" Height="7" Margin="9,1,0,0" VerticalAlignment="Center" Fill="{DynamicResource Accent}">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Active}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                      <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Blink">
                          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.45"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </DataTrigger.EnterActions>
                      <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Blink"/></DataTrigger.ExitActions>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,20,0">
            <TextBlock Text="{Binding Summary}" FontSize="13.5" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" Margin="0,1,0,0"
                       Visibility="{Binding HasSummary, Converter={StaticResource Visible}}"/>
            <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="15"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource GradeFill}" Tag="{Binding Grade}" Width="6" Height="6" CornerRadius="3" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,6,0,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" FontSize="13">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Grade}" Value="info"><Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Grid Grid.Column="2" Height="6" VerticalAlignment="Top" Margin="0,7,0,0">
            <Border CornerRadius="3" Background="{DynamicResource Bg.Track}"/>
            <Border Style="{StaticResource GradeFill}" Tag="{Binding Grade}" CornerRadius="3" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
              <Border.RenderTransform><ScaleTransform ScaleX="{Binding ScoreFraction}"/></Border.RenderTransform>
            </Border>
          </Grid>
          <TextBlock Grid.Column="3" Text="{Binding PercentText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" HorizontalAlignment="Right"
                     VerticalAlignment="Top" Typography.NumeralAlignment="Tabular"/>
          <Border Grid.Column="4" Style="{StaticResource GradePill}" Tag="{Binding Grade}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,0,0">
            <TextBlock Text="{Binding GradeLabel}" Tag="{Binding Grade}" Style="{StaticResource GradeText}" FontSize="12.5"/>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <Style x:Key="JobCard" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
      <Setter Property="Padding" Value="16,0,8,0"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <ContentPresenter/>
              </Border>
              <Border x:Name="Indicator" Width="3" Height="24" CornerRadius="1.5" Margin="0,16,0,0" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Hidden"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bg.Hover}"/></Trigger>
              <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
              </DataTrigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="JobRow">
      <StackPanel>
        <Grid MinHeight="52" Background="Transparent" ToolTip="{Binding Tip}" MouseLeftButtonDown="JobHeadMouseDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="40"/>
          </Grid.ColumnDefinitions>
          <ContentControl Content="{Binding IconState}" ContentTemplate="{StaticResource StateIcon}" Margin="0,0,12,0" Focusable="False" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
            <Run Text="{Binding RowTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="15"/>
            <Run Text="{Binding MetaText, Mode=OneWay}" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"/>
          </TextBlock>
          <Grid Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding Report.ElapsedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
              <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"
                         Visibility="{Binding HasRemaining, Converter={StaticResource Visible}}"
                         ToolTip="An estimate from this PC's earlier conversions. It settles once the map's zone has been read."/>
              <TextBlock Text="Paused" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Status.Warning}" Margin="12,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding IsPaused, Converter={StaticResource Visible}}"/>
              <ProgressBar x:Name="RunBar" Width="220" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="16,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding ProgressText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Width="52" TextAlignment="Right" VerticalAlignment="Center"
                         Typography.NumeralAlignment="Tabular"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE81C;" FontSize="12" Foreground="{DynamicResource Text.Muted}" Margin="0,0,8,0"
                         ToolTip="Converted earlier: this is the score of the last conversion" Visibility="{Binding IsEarlier, Converter={StaticResource Visible}}"/>
              <TextBlock Text="{Binding Note}" Tag="{Binding State}" Style="{StaticResource NoteText}" Margin="0,0,14,0" VerticalAlignment="Center"
                         Visibility="{Binding HasNote, Converter={StaticResource Visible}}"/>
              <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="12" Width="32" Height="32" MinHeight="32" Margin="-6,0,0,0" Click="JobCancelClick"
                      ToolTip="Take it out of this run. The rest of the queue carries on." Visibility="{Binding IsQueued, Converter={StaticResource Visible}}"/>
              <ItemsControl ItemsSource="{Binding Report.Dimensions}" Focusable="False" Margin="0,0,12,0" VerticalAlignment="Center"
                            Visibility="{Binding ShowScore, Converter={StaticResource Visible}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource GradeFill}" Tag="{Binding Grade}" Width="5" Height="16" CornerRadius="2.5" Margin="0,0,3,0">
                      <Border.ToolTip>
                        <TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding PercentText, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding GradeLabel, Mode=OneWay}"/></TextBlock>
                      </Border.ToolTip>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding Report.PercentText}" Tag="{Binding Report.ScoreGrade}" Style="{StaticResource GradeText}" FontSize="16" FontWeight="SemiBold" Width="52" TextAlignment="Right"
                         VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Visibility="{Binding ShowScore, Converter={StaticResource Visible}}"/>
            </StackPanel>
          </Grid>
          <TextBlock Grid.Column="3" Text="{Binding Size}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Typography.NumeralAlignment="Tabular"/>
          <Button x:Name="Chevron" Grid.Column="4" Style="{StaticResource Button.Icon}" Content="&#xE70D;" FontSize="12" HorizontalAlignment="Right" Click="ExpandClick"
                  ToolTip="Show or hide its report"/>
        </Grid>
        <DockPanel Margin="32,0,10,14" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button Padding="12,6" MinHeight="34" FontSize="13.5" Click="JobPauseClick" ToolTip="Pause or carry on with this one. Everything it has done so far is kept.">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding PauseGlyph}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding PauseText}"/>
              </StackPanel>
            </Button>
            <Button Padding="12,6" MinHeight="34" FontSize="13.5" Margin="8,0,0,0" Click="JobCancelClick" ToolTip="Stop converting this one. The rest of the queue carries on.">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE711;" FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="0,0,8,0"/>
                <TextBlock Text="Cancel"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Report.Steps}" ItemTemplate="{StaticResource ActiveStep}" Focusable="False" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.ItemContainerStyle>
          </ItemsControl>
        </DockPanel>
        <StackPanel Margin="32,0,10,16" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource Rule}" Margin="0,0,0,14"/>
          <TextBlock x:Name="NoReport" Text="Not converted yet. Its report shows here once it runs." Style="{StaticResource Text.Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     Visibility="Collapsed"/>
          <StackPanel x:Name="ReportBody" DataContext="{Binding Report}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
              <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" CornerRadius="11" Padding="10,3,10,4" Background="{DynamicResource Bg.Input}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding State}" Width="7" Height="7" Margin="0,1,7,0"/>
                  <TextBlock Text="{Binding StateLabel}" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}"/>
                </StackPanel>
              </Border>
              <Border DockPanel.Dock="Left" Style="{StaticResource GradePill}" Tag="{Binding ScoreGrade}" Margin="8,0,0,0" Visibility="{Binding ShowGrade, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Grade}" Tag="{Binding ScoreGrade}" Style="{StaticResource GradeText}" FontSize="12.5" FontWeight="SemiBold"/>
              </Border>
              <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Headline}" Margin="14,0,0,0"
                         VerticalAlignment="Center"/>
            </DockPanel>
            <Border Margin="0,14,0,0" Padding="14,8" CornerRadius="10" Background="{DynamicResource Status.Error.Soft}" Visibility="{Binding HasProblems, Converter={StaticResource Visible}}">
              <StackPanel>
                <DockPanel>
                  <ToggleButton x:Name="ProblemsToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle.Ghost}" Padding="10,3" MinHeight="28" FontSize="12.5" Content="Details" Margin="10,0,0,0"/>
                  <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="15" Foreground="{DynamicResource Status.Error}" Margin="0,0,11,0"/>
                  <TextBlock Text="{Binding ProblemSummary}" FontSize="13" Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding ProblemSummary}"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Problems}" Focusable="False" Margin="26,6,0,2" Visibility="{Binding IsChecked, ElementName=ProblemsToggle, Converter={StaticResource Visible}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" Margin="0,2"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <StackPanel Visibility="{Binding HasSteps, Converter={StaticResource Visible}}">
              <TextBlock Margin="0,18,0,0">
                <Run Text="STEPS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}"/><Run Text="    "/><Run Text="{Binding StepSummary, Mode=OneWay}" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"/>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepChip}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
            <TextBlock Text="PARTS" Style="{StaticResource Text.Section}" Margin="0,20,0,10"/>
            <ItemsControl ItemsSource="{Binding Dimensions}" ItemTemplate="{StaticResource DimensionRow}" Focusable="False"/>
            <Border Style="{StaticResource Rule}"/>
            <DockPanel Margin="0,12,0,0">
              <ItemsControl DockPanel.Dock="Right" ItemsSource="{StaticResource Grades}" ItemTemplate="{StaticResource LegendItem}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Text="{Binding AbsentSummary}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AbsentSummary}" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter TargetName="Chevron" Property="Content" Value="&#xE70E;"/></DataTrigger>
        <DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter TargetName="RunBar" Property="Opacity" Value="0.45"/></DataTrigger>
        <DataTrigger Binding="{Binding HasScore}" Value="False">
          <Setter TargetName="NoReport" Property="Visibility" Value="Visible"/>
          <Setter TargetName="ReportBody" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>


  <Grid x:Name="Shell" LayoutTransform="{DynamicResource Ui.Scale}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Grid x:Name="Rail" Background="{DynamicResource Bg.Rail}">
      <Rectangle Fill="{DynamicResource Accent.Glow}" Height="260" VerticalAlignment="Top" IsHitTestVisible="False"/>
      <DockPanel Margin="14,12,12,16" LastChildFill="False">
        <DockPanel DockPanel.Dock="Top" Margin="8,6,0,26">
          <Image x:Name="AppLogo" DockPanel.Dock="Left" Source="{StaticResource Logo}" Width="42" Height="42" VerticalAlignment="Center"/>
          <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="PS4 .FF Porter" FontSize="16.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="GameText" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top">
          <RadioButton x:Name="ConvertTab" Style="{StaticResource Nav.Item}" Tag="&#xE8AB;" Content="Convert" GroupName="Section" IsChecked="True"
                       ToolTip="Convert your own maps, mods and zones"/>
          <RadioButton x:Name="ConvertedTab" Style="{StaticResource Nav.Item}" Tag="&#xE930;" Content="Converted" GroupName="Section"
                       ToolTip="Converted maps and mods in your output folder, ready to send to your console"/>
          <RadioButton x:Name="CommunityTab" Style="{StaticResource Nav.Item}" Tag="&#xE774;" Content="Community" GroupName="Section"
                       ToolTip="Download maps and mods the community already converted"/>
          <RadioButton x:Name="InstalledTab" Style="{StaticResource Nav.Item}" Tag="&#xE7FC;" Content="Installed" GroupName="Section"
                       ToolTip="What is on your console, on its own storage and on every drive"/>
        </StackPanel>

        <TextBlock x:Name="AuthorText" DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" FontSize="12" Margin="14,12,0,0" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Grid>

    <Border Grid.Column="1" Style="{StaticResource Sheet}">
      <Grid Margin="30,24,30,26">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Display}" Text="Convert"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Subtitle}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Text="Drop maps, mods, weapons and zones. The files that belong with them and the tools are found automatically."/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="GameFolderButton" Style="{StaticResource Button.Field}" Click="ChooseGameFolderClick" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7FC;" FontSize="15" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
                <TextBlock x:Name="GameFolderLabel" Text="Game files" Foreground="{DynamicResource Text.Muted}" Margin="0,0,9,0"/>
                <TextBlock x:Name="GameFolderText" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
              </StackPanel>
            </Button>
            <Button x:Name="OutputButton" Style="{StaticResource Button.Field}" Click="ChooseOutputClick" ToolTip="Change where converted files go">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem x:Name="DefaultOutputItem" Header="Use the default folder" Click="DefaultOutputClick"/>
                </ContextMenu>
              </Button.ContextMenu>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8B7;" FontSize="15" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
                <TextBlock x:Name="OutputLabel" Text="Output" Foreground="{DynamicResource Text.Muted}" Margin="0,0,9,0"/>
                <TextBlock x:Name="OutputText" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource Button.Icon}" Content="&#xE8A7;" Width="40" Height="40" Margin="6,0,0,0" Click="OpenOutputClick" ToolTip="Open the output folder"/>
          </StackPanel>
        </Grid>

        <controls:CommunityPanel x:Name="Community" Grid.Row="2" Visibility="Collapsed"/>
        <controls:ConsolePanel x:Name="OnConsole" Grid.Row="2" Visibility="Collapsed"/>
        <controls:ConvertedPanel x:Name="Converted" Grid.Row="2" Visibility="Collapsed"/>

        <Border x:Name="ConvertView" Grid.Row="2" Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="26,18,16,14">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RemoveButton" Style="{StaticResource Button.Icon}" Content="&#xE74D;" Click="RemoveClick" ToolTip="Remove the selected items (Delete)"/>
                <Button x:Name="ClearButton" Style="{StaticResource Button.Icon}" Content="&#xE894;" Click="ClearClick" ToolTip="Clear the queue" Margin="2,0,8,0"/>
                <Button x:Name="AddButton" Click="AddClick" Padding="14,7" MinHeight="36" ToolTip="Add maps, mods or zones to convert">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Files…" Click="AddFilesClick"/>
                      <MenuItem Header="A folder…" Click="AddFolderClick"/>
                      <MenuItem x:Name="AddInstalledItem" Header="Installed maps and mods…" Click="AddInstalledClick"/>
                    </ContextMenu>
                  </Button.ContextMenu>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE710;" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,0,9,0"/>
                    <TextBlock Text="Add"/>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE70D;" FontSize="10" Foreground="{DynamicResource Text.Muted}" Margin="10,1,0,0"/>
                  </StackPanel>
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Queue" Style="{StaticResource Text.Heading}" FontSize="17"/>
                <Border Style="{StaticResource Chip}" Margin="11,1,0,0"><TextBlock x:Name="CountText" Text="0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}"/></Border>
                <TextBlock x:Name="TotalText" Style="{StaticResource Text.Caption}" Margin="11,1,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"
                           ToolTip="Total size of everything in the queue: each item's zones, xpaks and sound banks"/>
              </StackPanel>
            </DockPanel>

            <Grid x:Name="EmptyQueue" Grid.Row="1" Margin="18,0,18,18">
              <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource Border.Default}" StrokeThickness="1.5" StrokeDashArray="5 4" SnapsToDevicePixels="True"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Border Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource IconTile.Glyph}" Text="&#xE896;"/></Border>
                <TextBlock Text="Drop anything here" Style="{StaticResource Text.Title}" FontSize="19" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock x:Name="EmptyQueueText" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                           Text="Any .ff file or folder of maps, mods or zones."/>
                <Button x:Name="InstalledButton" HorizontalAlignment="Center" Margin="0,22,0,0" Click="AddInstalledClick"
                        ToolTip="Pick from the maps and mods in your game files folder and your Steam Workshop items">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8F1;" FontSize="14" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Pick from installed maps and mods"/></StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <ListBox x:Name="JobList" Grid.Row="1" Margin="10,0,10,10" SelectionMode="Extended" ItemContainerStyle="{StaticResource JobCard}" ItemTemplate="{StaticResource JobRow}"
                     ScrollViewer.CanContentScroll="False" SelectionChanged="JobSelectionChanged" KeyDown="JobListKeyDown" ContextMenuOpening="JobMenuOpening">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem x:Name="JobSendItem" Header="Send to the console" Click="JobSendClick"/>
                  <MenuItem x:Name="JobOpenItem" Header="Open its folder" Click="OpenOutputClick"/>
                  <MenuItem x:Name="JobRemoveItem" Header="Remove from the queue" InputGestureText="Del" Click="RemoveClick"/>
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.ContainerStyle>
                    <Style TargetType="GroupItem">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="GroupItem">
                            <StackPanel>
                              <ToggleButton x:Name="Header" Style="{StaticResource Toggle.Group}" Padding="17,0,9,0" MinHeight="54" Margin="0,0,0,4" IsChecked="{Binding Name.IsExpanded, Mode=TwoWay}"
                                            ToolTip="Show or hide this mod's zones">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="40"/>
                                  </Grid.ColumnDefinitions>
                                  <ContentControl Content="{Binding Name.State}" ContentTemplate="{StaticResource StateIcon}" Margin="0,0,12,0" Focusable="False" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <Run Text="{Binding Name.Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="15"/>
                                    <Run Text="{Binding Name.Summary, Mode=OneWay, StringFormat='    {0}'}" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"/>
                                  </TextBlock>
                                  <Grid Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding Name.IsActive, Converter={StaticResource Visible}}">
                                      <TextBlock Text="{Binding Name.Note}" Style="{StaticResource NoteText}" Tag="{Binding Name.NoteState}" Margin="0,0,12,0" VerticalAlignment="Center"
                                                 Visibility="{Binding Name.HasNote, Converter={StaticResource Visible}}"/>
                                      <TextBlock Text="{Binding Name.DoneText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                                      <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Visibility="{Binding Name.IsRunning, Converter={StaticResource Visible}}">
                                        <ProgressBar Width="220" Maximum="1" Value="{Binding Name.Progress, Mode=OneWay}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name.ProgressText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Width="52" TextAlignment="Right"
                                                   Typography.NumeralAlignment="Tabular"/>
                                      </StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="Result" Orientation="Horizontal">
                                      <TextBlock Text="{Binding Name.Note}" Style="{StaticResource NoteText}" Tag="{Binding Name.NoteState}" Margin="0,0,12,0" VerticalAlignment="Center"
                                                 Visibility="{Binding Name.HasNote, Converter={StaticResource Visible}}"/>
                                      <TextBlock Text="{Binding Name.ScoreText}" Tag="{Binding Name.ScoreGrade}" Style="{StaticResource GradeText}" FontSize="16" FontWeight="SemiBold"
                                                 Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                  </Grid>
                                  <TextBlock Grid.Column="3" Text="{Binding Name.SizeText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                             Typography.NumeralAlignment="Tabular"/>
                                  <TextBlock x:Name="Chevron" Grid.Column="4" Style="{StaticResource Text.Icon}" Text="&#xE70E;" FontSize="12" Foreground="{DynamicResource Text.Muted}"
                                             HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                </Grid>
                              </ToggleButton>
                              <ItemsPresenter x:Name="Items" Margin="32,0,0,4"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                              <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                <Setter TargetName="Header" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Items" Property="Margin" Value="0"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Name.IsExpanded}" Value="False">
                                <Setter TargetName="Items" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Name.IsActive}" Value="True">
                                <Setter TargetName="Result" Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </GroupStyle.ContainerStyle>
                </GroupStyle>
              </ListBox.GroupStyle>
            </ListBox>
          </Grid>
        </Border>

        <controls:LogView x:Name="Log" Grid.Row="3" Height="230" Margin="0,18,0,0" Visibility="Collapsed" SaveName="converter.log"/>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="22,12,14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
              <DockPanel>
                <TextBlock x:Name="PercentText" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Typography.NumeralAlignment="Tabular" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusLine" TextTrimming="CharacterEllipsis" FontSize="14.5">
                  <Run x:Name="StatusText" Text="Drop something to convert" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                  <Run x:Name="DetailText" Text="" FontSize="13.5" Foreground="{DynamicResource Text.Muted}"/>
                </TextBlock>
              </DockPanel>
              <ProgressBar x:Name="Progress" Maximum="1" Margin="0,10,0,0" Visibility="Hidden"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" MinHeight="44">
              <Button x:Name="UpdateButton" Style="{StaticResource Button.Ghost}" Foreground="{DynamicResource Text.Primary}" Margin="0,0,2,0" Click="UpdateClick" Visibility="Collapsed"
                      ToolTip="A newer version is out. It is downloaded and installed, then the app restarts by itself.">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE777;" FontSize="15" Margin="0,0,9,0" Foreground="{DynamicResource Accent}"/>
                  <TextBlock Text="Update"/>
                </StackPanel>
              </Button>
              <Button x:Name="SettingsButton" Style="{StaticResource Button.Ghost}" Margin="0,0,2,0" Click="SettingsClick" ToolTipService.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE713;" FontSize="15" Margin="0,0,9,0"/><TextBlock Text="Settings"/></StackPanel>
              </Button>
              <Button x:Name="ClearCacheButton" Style="{StaticResource Button.Ghost}" Margin="0,0,2,0" Click="ClearCacheClick" ToolTipOpening="CacheTipOpening"
                      ToolTipService.ShowOnDisabled="True">
                <Button.ToolTip>
                  <ToolTip>
                    <StackPanel>
                      <TextBlock x:Name="CacheSizeText" FontWeight="SemiBold"/>
                      <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                                 Text="Saved work that makes conversions faster: compiled shaders, zone reads, converted sound. Clearing it makes the next conversion slower."/>
                    </StackPanel>
                  </ToolTip>
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xEA99;" FontSize="15" Margin="0,0,9,0"/><TextBlock Text="Clear cache"/></StackPanel>
              </Button>
              <ToggleButton x:Name="LogToggle" Style="{StaticResource Toggle.Ghost}" Checked="LogToggled" Unchecked="LogToggled" ToolTip="Show everything the converter printed">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE756;" FontSize="15" Margin="0,0,9,0"/><TextBlock Text="Log"/></StackPanel>
              </ToggleButton>
              <Button x:Name="SendButton" Margin="12,0,0,0" MinHeight="44" Padding="18,8" Click="SendClick" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE724;" FontSize="14" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
                  <TextBlock x:Name="SendText" Text="Send to console"/>
                </StackPanel>
              </Button>
              <Button x:Name="CancelButton" Content="Cancel" Margin="10,0,0,0" MinHeight="44" MinWidth="120" Padding="18,8" Click="CancelClick" Visibility="Collapsed"/>
              <Button x:Name="ConvertButton" Style="{StaticResource Button.Primary}" Margin="10,0,0,0" MinHeight="44" MinWidth="150" FontSize="15" Click="ConvertClick" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE768;" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource Accent.Text}"/>
                  <TextBlock Text="Convert"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="PrepareOverlay" Grid.ColumnSpan="2" Background="{DynamicResource Bg.Overlay}" Panel.ZIndex="10" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,26">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE896;" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="Preparing files" Style="{StaticResource Text.Heading}" FontSize="17"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Text.Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,12,0,0"
                     Text="Setting up the tools. This only happens once."/>
          <ProgressBar IsIndeterminate="True" Margin="0,18,0,0"/>
          <TextBlock x:Name="PrepareDetail" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="UpdateOverlay" Grid.ColumnSpan="2" Background="{DynamicResource Bg.Overlay}" Panel.ZIndex="11" Visibility="Collapsed"
          KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
      <Border Style="{StaticResource Card}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,26">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE777;" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock x:Name="UpdateHeading" Text="Installing an update" Style="{StaticResource Text.Heading}" FontSize="17"/>
          </StackPanel>
          <TextBlock x:Name="UpdateBody" Style="{StaticResource Text.Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/>
          <Border x:Name="UpdateNotesBox" Background="{DynamicResource Bg.Input}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10"
                  Padding="14,12,8,12" Margin="0,16,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="WHAT IS NEW" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
              <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <TextBlock x:Name="UpdateNotes" FontSize="13" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,8,0"/>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <ProgressBar x:Name="UpdateProgress" Maximum="1" Margin="0,18,0,0"/>
          <DockPanel Margin="0,16,0,0">
            <Button x:Name="UpdateCancel" DockPanel.Dock="Right" Content="Not now" MinWidth="110" Margin="12,0,0,0" Click="UpdateCancelClick"/>
            <TextBlock x:Name="UpdateDetail" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
